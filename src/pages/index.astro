---
import Layout from '@/layouts/Layout.astro';
import Section from '@/components/layout/Section.astro';
import Hero from '@/components/sections/Hero.astro';
---
<Layout>
  <Hero />
  <Section id="collection">
    <h1 style="font-weight: var(--fw-black)">Тестовая секция</h1>
    <p>Так выглядит блок внутри контейнера.</p>
  </Section>
  <Section id="about">
    <h2 style="font-weight: var(--fw-bold)">Вторая секция</h2>
  </Section>
  <Section id="catalog">
    <h2 style="font-weight: var(--fw-bold)">Каталог моделей</h2>
  </Section>
</Layout>
