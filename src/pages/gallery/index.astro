---
import Layout from '@/layouts/Layout.astro';
import Section from '@/components/layout/Section.astro';
import BackLink from '@/components/ui/BackLink.astro';
import GalleryHero from '@/components/sections/GalleryHero.astro';
import WallBuilder from '@/components/islands/WallBuilder';
import { galleryBackHref, galleryBackLabel, galleryDescription, galleryTitle } from '@/data/gallery';
---
<Layout title={galleryTitle} description={galleryDescription}>
  <Section>
    <div class="gallery">
      <BackLink href={galleryBackHref} label={galleryBackLabel} />

      <GalleryHero />

      <WallBuilder client:visible />
    </div>
  </Section>
</Layout>

<style>
  .gallery {
    --gallery-gap: clamp(20px, 3vw, 40px);

    display: flex;
    flex-direction: column;
    gap: var(--gallery-gap);
    color: var(--color-text-inverse);
  }
</style>
