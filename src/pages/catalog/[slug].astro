---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import Section from '@/components/layout/Section.astro';
import Button from '@/components/ui/Button.astro';
import ModelCard from '@/components/ui/ModelCard.astro';
import {
  catalogCtaLabel,
  catalogFilters,
  modelAboutTitle,
  modelBackLabel,
  modelImageKinds,
  modelMoreTitle,
  modelPhotoPickLabel,
  modelSpecsTitle,
} from '@/data/catalog';
import { getApprovedModels, modelHref } from '@/data/models';

// страница генерируется для каждой approved-модели, адрес = имя папки
export async function getStaticPaths() {
  const models = await getApprovedModels();
  return models.map((model) => ({ params: { slug: model.id }, props: { model } }));
}

const { model } = Astro.props;
const { title, summary, description, category, price, images, specs } = model.data;
const categoryLabel = catalogFilters.find((filter) => filter.id === category)?.label;
const paragraphs = description ? description.split(/\n\s*\n/) : [];
// лента под страницей: остальные модели каталога
const others = (await getApprovedModels()).filter((other) => other.id !== model.id);
---
<Layout title={`${title} – В голове у Даньки`} description={summary}>
  <Section>
    <div class="model">
      <a class="model__back" href="/#catalog">
        <svg viewBox="0 0 10 16" aria-hidden="true"><path d="M8 2 2 8l6 6" /></svg>
        {modelBackLabel}
      </a>

      <div class="model__layout">
        <div class="model__main">
          <!-- рамка как у панели Hero: стекло, чёрная обводка и тень внутрь -->
          <div class="model__gallery" data-gallery>
            {images.length > 1 && (
              <div class="model__thumbs" role="group" aria-label={modelPhotoPickLabel}>
                {images.map((photo, index) => (
                  <button
                    class="model__thumb"
                    type="button"
                    aria-pressed={index === 0 ? 'true' : 'false'}
                    aria-label={`${modelPhotoPickLabel} ${index + 1}`}
                    data-gallery-thumb={index}
                  >
                    <Image src={photo.src} alt="" widths={[120, 240]} sizes="120px" />
                  </button>
                ))}
              </div>
            )}

            <div class="model__stage">
              {images.length > 0 ? (
                images.map((photo, index) => (
                  <figure class="model__photo" data-gallery-photo={index} hidden={index !== 0}>
                    <Image
                      src={photo.src}
                      alt={photo.alt ?? title}
                      widths={[480, 720, 960]}
                      sizes="(max-width: 900px) 90vw, 560px"
                      loading={index === 0 ? 'eager' : 'lazy'}
                    />
                    <figcaption class="model__kind">{modelImageKinds[photo.kind]}</figcaption>
                  </figure>
                ))
              ) : (
                <svg class="model__placeholder" viewBox="0 0 48 48" aria-hidden="true">
                  <path d="M24 6 40 15v18L24 42 8 33V15z M8 15l16 9 16-9 M24 24v18" />
                </svg>
              )}
            </div>
          </div>

          <div class="model__card model__about">
            <h2 class="model__about-title">{modelAboutTitle}</h2>
            <p class="model__summary">{summary}</p>
            {paragraphs.length > 0 && (
              <div class="model__text">
                {paragraphs.map((text) => <p>{text}</p>)}
              </div>
            )}

            {specs.length > 0 && (
              <div class="model__specs">
                <h3 class="model__specs-title">{modelSpecsTitle}</h3>
                <dl>
                  {specs.map((spec) => (
                    <div class="model__spec">
                      <dt>{spec.label}</dt>
                      <dd>{spec.value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            )}
          </div>
        </div>

        <aside class="model__aside">
          <div class="model__card model__buy">
            {categoryLabel && <span class="model__category">{categoryLabel}</span>}
            <h1 class="model__title">{title}</h1>
            {price && <span class="model__price">{price}</span>}
            <!-- куда ведёт заказ, пока не решено -->
            <Button class="model__cta" href="#" arrow>{catalogCtaLabel}</Button>
          </div>
        </aside>
      </div>

      {others.length > 0 && (
        <div class="model__more">
          <h2 class="model__more-title">{modelMoreTitle}</h2>
          <div class="model__more-list">
            {others.map(({ id, data }) => (
              <ModelCard
                title={data.title}
                text={data.summary}
                category={data.category}
                href={modelHref(id)}
                price={data.price}
                ctaLabel={catalogCtaLabel}
                image={data.images[0]?.src}
              />
            ))}
          </div>
        </div>
      )}
    </div>
  </Section>
</Layout>

<style>
  .model {
    --model-gap: clamp(20px, 3vw, 40px);
    --model-gap-sm: clamp(10px, 1.2vw, 14px);
    /* слева и сверху отступ больше: там лежит тень внутрь */
    --model-panel-padding: clamp(20px, 3vw, 40px);
    --model-panel-shadow-space: 13px;
    --model-card-padding: clamp(18px, 2vw, 28px);
    --model-aside-width: clamp(280px, 30%, 380px);
    --model-thumb-size: clamp(64px, 8vw, 104px);
    --model-ribbon-card: clamp(220px, 24%, 280px);
    --model-back-arrow: 0.75em;
    --model-arrow-stroke: 2.5px;
    --model-kind-padding: 2px 10px;
    --model-placeholder-size: 40%;
    --model-glass-blur: 1px;

    display: flex;
    flex-direction: column;
    gap: var(--model-gap);
    color: var(--color-text-inverse);
  }

  .model__back {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: calc(var(--model-gap-sm) / 2);
    color: inherit;
    font-size: var(--fs-hint);
    font-weight: var(--fw-semibold);
    text-decoration: none;
  }

  .model__back:focus-visible {
    color: var(--color-accent);
  }

  @media (hover: hover) {
    .model__back:hover {
      color: var(--color-accent);
    }
  }

  .model__back svg {
    width: var(--model-back-arrow);
    height: var(--model-back-arrow);
    fill: none;
    stroke: currentColor;
    stroke-width: var(--model-arrow-stroke);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .model__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--model-aside-width);
    align-items: start;
    gap: var(--model-gap);
  }

  .model__main {
    display: flex;
    flex-direction: column;
    gap: var(--model-gap-sm);
  }

  /* галерея в стекле как у панели Hero: мелкие фото столбиком слева, большое справа */
  .model__gallery {
    display: flex;
    gap: var(--model-gap-sm);
    padding: calc(var(--model-panel-padding) + var(--model-panel-shadow-space)) var(--model-panel-padding)
      var(--model-panel-padding) calc(var(--model-panel-padding) + var(--model-panel-shadow-space));
    border: var(--stroke-panel) solid var(--color-black);
    border-radius: var(--radius-panel);
    background: var(--color-hero-glass);
    backdrop-filter: blur(var(--model-glass-blur));
    box-shadow: var(--shadow-panel-inset);
  }

  .model__thumbs {
    display: flex;
    flex-direction: column;
    flex: none;
    gap: var(--model-gap-sm);
  }

  .model__thumb {
    width: var(--model-thumb-size);
    aspect-ratio: 1;
    overflow: hidden;
    padding: 0;
    border: var(--stroke-lift) solid transparent;
    border-radius: var(--radius-card-sm);
    background: var(--color-hero-glass);
    cursor: pointer;
    transition: transform var(--transition-lift), box-shadow var(--transition-lift), border-color var(--transition-lift);
  }

  .model__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* выбранное фото «нажато»: акцентная обводка, стоит на месте */
  .model__thumb[aria-pressed='true'] {
    border-color: var(--color-accent);
  }

  .model__thumb:focus-visible {
    transform: translateY(var(--lift-hover-sm));
    border-color: var(--color-black);
    box-shadow: var(--shadow-lift-sm);
    outline: none;
  }

  @media (hover: hover) {
    .model__thumb[aria-pressed='false']:hover {
      transform: translateY(var(--lift-hover-sm));
      border-color: var(--color-black);
      box-shadow: var(--shadow-lift-sm);
    }
  }

  .model__stage {
    display: grid;
    flex: 1;
    place-items: center;
    min-width: 0;
    aspect-ratio: 4 / 3;
  }

  .model__photo {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .model__photo[hidden] {
    display: none;
  }

  /* рендер целиком, без обрезки */
  .model__photo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .model__placeholder {
    width: var(--model-placeholder-size);
    fill: none;
    stroke: var(--color-bg);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  /* метка «Рендер» / «Фото» */
  .model__kind {
    position: absolute;
    top: 0;
    right: 0;
    padding: var(--model-kind-padding);
    border-radius: var(--radius-pill);
    background: var(--color-info);
    color: var(--color-dark);
    font-size: var(--fs-hint);
    font-weight: var(--fw-semibold);
  }

  .model__about-title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-black);
    line-height: 1.1;
  }

  .model__summary {
    font-size: var(--fs-card-title);
    font-weight: var(--fw-bold);
    line-height: 1.2;
  }

  .model__text {
    display: flex;
    flex-direction: column;
    gap: var(--model-gap-sm);
    font-size: var(--fs-card-text);
    font-weight: var(--fw-medium);
    line-height: 1.4;
  }

  .model__specs {
    margin-top: var(--model-gap-sm);
  }

  .model__specs-title {
    margin-bottom: calc(var(--model-gap-sm) / 2);
    font-size: var(--fs-card-title);
    font-weight: var(--fw-bold);
  }

  .model__spec {
    display: flex;
    justify-content: space-between;
    gap: var(--model-gap-sm);
    padding-block: calc(var(--model-gap-sm) / 2);
    border-bottom: 1px solid var(--color-hero-glass);
    font-size: var(--fs-card-text);
  }

  .model__spec dt {
    font-weight: var(--fw-medium);
  }

  .model__spec dd {
    font-weight: var(--fw-semibold);
    text-align: end;
  }

  /* правая колонка едет вместе с прокруткой */
  .model__aside {
    position: sticky;
    top: var(--model-gap);
    display: flex;
    flex-direction: column;
    gap: var(--model-gap-sm);
  }

  .model__card {
    display: flex;
    flex-direction: column;
    gap: var(--model-gap-sm);
    padding: var(--model-card-padding);
    border-radius: var(--radius-card-lg);
    background: var(--color-deep);
  }

  .model__category {
    color: var(--color-accent);
    font-size: var(--fs-hint);
    font-weight: var(--fw-semibold);
  }

  .model__title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-black);
    line-height: 1.1;
    text-wrap: balance;
  }

  .model__price {
    font-size: var(--fs-card-title);
    font-weight: var(--fw-bold);
  }

  .model__buy :global(.model__cta) {
    margin-top: calc(var(--model-gap-sm) / 2);
  }

  .model__more {
    display: flex;
    flex-direction: column;
    gap: var(--model-gap-sm);
  }

  .model__more-title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-black);
    line-height: 1.1;
  }

  /* лента листается вбок; паддинг оставляет место под подъём и тень карточек */
  .model__more-list {
    display: grid;
    grid-auto-columns: var(--model-ribbon-card);
    grid-auto-flow: column;
    gap: var(--model-gap-sm);
    overflow-x: auto;
    padding-block: var(--model-gap-sm);
    padding-inline-end: var(--model-gap-sm);
    scroll-snap-type: x mandatory;
  }

  .model__more-list > :global(*) {
    scroll-snap-align: start;
  }

  @media (prefers-reduced-motion: reduce) {
    .model__thumb {
      transition: none;
    }

    .model__thumb:focus-visible,
    .model__thumb[aria-pressed='false']:hover {
      transform: none;
    }
  }

  /* узкий экран: одна колонка, порядок галерея, покупка, «Об айтеме» */
  @media (max-width: 900px) {
    .model__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .model__main {
      display: contents;
    }

    .model__gallery {
      order: 1;
    }

    .model__aside {
      position: static;
      order: 2;
    }

    .model__about {
      order: 3;
    }
  }

  /* телефон: мелкие фото рядом под большим */
  @media (max-width: 720px) {
    .model {
      --model-panel-padding: 16px;
      --model-panel-shadow-space: 8px;
      --model-ribbon-card: 45%;
    }

    .model__gallery {
      flex-direction: column-reverse;
    }

    .model__thumbs {
      flex-direction: row;
      overflow-x: auto;
      padding-block: var(--lift-hover-sm) 0;
    }

    .model__thumb {
      flex: none;
    }
  }
</style>

<script>
  // клик по мелкому фото показывает его в большом окне
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const thumbs = gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]');
    const photos = gallery.querySelectorAll<HTMLElement>('[data-gallery-photo]');

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const index = thumb.dataset.galleryThumb;
        thumbs.forEach((other) => other.setAttribute('aria-pressed', String(other === thumb)));
        photos.forEach((photo) => {
          photo.hidden = photo.dataset.galleryPhoto !== index;
        });
      });
    });
  });
</script>
