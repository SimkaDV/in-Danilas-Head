---
import { Image } from 'astro:assets';
import conveyor from '@/assets/catalog-conveyor.png';
import printerPhoto from '@/assets/catalog-printer.jpg';
import Section from '@/components/layout/Section.astro';
import CatalogFilter from '@/components/islands/CatalogFilter.tsx';
import ModelCard from '@/components/ui/ModelCard.astro';
import {
  catalogCtaLabel,
  catalogFilters,
  catalogFiltersLabel,
  catalogNotes,
  catalogPhotoAlt,
  catalogPhotoCloseLabel,
  catalogPhotoZoomLabel,
  catalogTitle,
} from '@/data/catalog';
import { getApprovedModels, modelHref } from '@/data/models';

const models = await getApprovedModels();
---
<Section id="catalog">
  <div class="catalog" data-catalog>
    <h2 class="catalog__title">{catalogTitle}</h2>

    <div class="catalog__scene">
      <!-- позже здесь будет анимационная сцена конвейера -->
      <div class="catalog__stage">
        <Image
          class="catalog__conveyor"
          src={conveyor}
          alt="Принтер печатает модели, и они едут по конвейеру"
          widths={[480, 720, 968]}
          sizes="(max-width: 720px) 90vw, 800px"
        />
      </div>
      <div class="catalog__notes">
        {catalogNotes.map((note) => (
        <div class:list={['catalog__note', `catalog__note--${note.id}`]}>
          <p>{note.text}</p>
          {note.id === 'printer' && (
            <button class="catalog__zoom" type="button" data-zoom-open aria-label={catalogPhotoZoomLabel}>
              <Image
                class="catalog__note-photo"
                src={printerPhoto}
                alt=""
                widths={[200, 400]}
                sizes="(max-width: 720px) 40vw, 140px"
              />
              <span class="catalog__zoom-icon" aria-hidden="true">
                <svg viewBox="0 0 16 16"><path d="M9.5 2.5h4v4M13.5 2.5 9 7M6.5 13.5h-4v-4M2.5 13.5 7 9" /></svg>
              </span>
            </button>
          )}
        </div>
        ))}
      </div>
    </div>

    <dialog class="catalog__lightbox" data-zoom-dialog aria-label={catalogPhotoAlt}>
      <Image
        class="catalog__lightbox-photo"
        src={printerPhoto}
        alt={catalogPhotoAlt}
        widths={[640, 1080, 1600]}
        sizes="(max-width: 960px) 92vw, 900px"
      />
      <form method="dialog">
        <button class="catalog__lightbox-close" aria-label={catalogPhotoCloseLabel}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
        </button>
      </form>
    </dialog>

    <CatalogFilter client:visible label={catalogFiltersLabel} filters={catalogFilters} />

    <div class="catalog__grid" data-catalog-grid>
      {models.map(({ id, data }) => (
        <ModelCard
          title={data.title}
          text={data.summary}
          category={data.category}
          price={data.price}
          href={modelHref(id)}
          ctaLabel={catalogCtaLabel}
          image={data.images[0]?.src}
        />
      ))}
    </div>
  </div>
</Section>

<style>
  .catalog {
    --catalog-gap: clamp(20px, 3vw, 40px);
    --catalog-grid-gap: clamp(12px, 1.6vw, 20px);
    --catalog-card-min: 240px;
    --catalog-note-width: clamp(160px, 22vw, 260px);
    --catalog-note-padding: clamp(12px, 1.4vw, 18px);
    --catalog-note-offset: clamp(8px, 2vw, 24px);
    --catalog-note-printer-width: clamp(260px, 30vw, 360px);
    --catalog-notes-right: var(--catalog-note-offset);
    --catalog-notes-gap: clamp(6px, 0.8vw, 10px);
    --catalog-note-shift: clamp(40px, 7vw, 100px);
    --catalog-note-photo-width: clamp(96px, 11vw, 140px);
    --catalog-zoom-icon-size: 28px;
    --catalog-zoom-icon-inset: 6px;
    --catalog-lightbox-max-width: 92vw;
    --catalog-lightbox-max-height: 90vh;
    --catalog-stage-inset: calc(var(--radius-panel) * 0.6);
    --catalog-conveyor-width: 80%;

    display: flex;
    flex-direction: column;
    gap: var(--catalog-gap);
  }

  .catalog__title {
    color: var(--color-text-inverse);
    font-size: var(--fs-h2);
    font-weight: var(--fw-black);
    line-height: 1.05;
    text-align: center;
    text-shadow: var(--shadow-title);
    text-wrap: balance;
  }

  .catalog__scene {
    position: relative;
  }

  .catalog__stage {
    display: flex;
    align-items: flex-end;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    padding-inline: var(--catalog-stage-inset);
    border: var(--stroke-panel) solid var(--color-black);
    border-radius: var(--radius-panel);
    background: var(--color-hero-glass);
    box-shadow: var(--shadow-panel-inset);
  }

  /* картинка обрезана по низу, поэтому стоит прямо на дне панели */
  .catalog__conveyor {
    width: var(--catalog-conveyor-width);
    height: auto;
  }

  /* облачка стопкой справа, второе сдвинуто вправо */
  .catalog__notes {
    position: absolute;
    top: var(--catalog-note-offset);
    right: var(--catalog-notes-right);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--catalog-notes-gap);
  }

  .catalog__note {
    padding: var(--catalog-note-padding);
    border: var(--stroke-panel) solid var(--color-black);
    background: var(--color-info);
    box-shadow: var(--shadow-sticker);
    color: var(--color-dark);
    font-size: var(--fs-hint);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
  }

  .catalog__note--printer {
    display: grid;
    margin-inline-end: var(--catalog-note-shift);
    grid-template-columns: minmax(0, 1fr) var(--catalog-note-photo-width);
    align-items: center;
    gap: var(--catalog-note-padding);
    width: var(--catalog-note-printer-width);
    border-radius: var(--radius-card-lg) var(--radius-card-lg) var(--radius-card-lg) var(--radius-card-sm);
  }

  /* фото – кнопка: по нажатию открывается крупно */
  .catalog__zoom {
    position: relative;
    display: block;
    padding: 0;
    border: var(--stroke-lift) solid var(--color-black);
    border-radius: var(--radius-card-sm);
    background: none;
    cursor: zoom-in;
    transition: transform var(--transition-lift), box-shadow var(--transition-lift);
  }

  .catalog__note-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: calc(var(--radius-card-sm) - var(--stroke-lift));
  }

  /* ненавязчивый значок «развернуть» в углу, чтобы было понятно, что фото открывается */
  .catalog__zoom-icon,
  .catalog__lightbox-close {
    display: grid;
    place-items: center;
    width: var(--catalog-zoom-icon-size);
    height: var(--catalog-zoom-icon-size);
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-black);
  }

  .catalog__zoom-icon {
    position: absolute;
    right: var(--catalog-zoom-icon-inset);
    bottom: var(--catalog-zoom-icon-inset);
  }

  .catalog__zoom-icon svg,
  .catalog__lightbox-close svg {
    width: 55%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .catalog__zoom:focus-visible {
    transform: translateY(var(--lift-hover-sm));
    box-shadow: var(--shadow-lift-sm);
    outline: none;
  }

  /* окно по размеру фото, без пустых полей */
  .catalog__lightbox {
    width: fit-content;
    max-width: var(--catalog-lightbox-max-width);
    max-height: var(--catalog-lightbox-max-height);
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: var(--stroke-panel) solid var(--color-black);
    border-radius: var(--radius-card-sm);
    background: var(--color-dark);
  }

  .catalog__lightbox::backdrop {
    background: var(--color-backdrop);
  }

  .catalog__lightbox-photo {
    display: block;
    width: auto;
    height: auto;
    max-width: calc(var(--catalog-lightbox-max-width) - 2 * var(--stroke-panel));
    max-height: calc(var(--catalog-lightbox-max-height) - 2 * var(--stroke-panel));
  }

  .catalog__lightbox-close {
    position: absolute;
    top: var(--catalog-zoom-icon-inset);
    right: var(--catalog-zoom-icon-inset);
    --catalog-zoom-icon-size: 40px;

    padding: 0;
    border: var(--stroke-lift) solid var(--color-black);
    cursor: pointer;
    transition: transform var(--transition-lift), box-shadow var(--transition-lift);
  }

  .catalog__lightbox-close:focus-visible {
    transform: translateY(var(--lift-hover-sm));
    box-shadow: var(--shadow-lift-sm);
    outline: none;
  }

  /* на таче :hover залипает после тапа, поэтому ховер только для мыши */
  @media (hover: hover) {
    .catalog__zoom:hover,
    .catalog__lightbox-close:hover {
      transform: translateY(var(--lift-hover-sm));
      box-shadow: var(--shadow-lift-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .catalog__zoom,
    .catalog__lightbox-close {
      transition: none;
    }

    .catalog__zoom:hover,
    .catalog__zoom:focus-visible,
    .catalog__lightbox-close:hover,
    .catalog__lightbox-close:focus-visible {
      transform: none;
    }
  }

  .catalog__note--catalog {
    width: var(--catalog-note-width);
    border-radius: var(--radius-card-lg) var(--radius-card-sm) var(--radius-card-lg) var(--radius-card-lg);
  }

  .catalog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--catalog-card-min), 1fr));
    gap: var(--catalog-grid-gap);
  }

  @media (max-width: 720px) {
    .catalog {
      --catalog-grid-gap: 10px;
    }

    /* как на маркетплейсах: две карточки в ряд */
    .catalog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .catalog__stage {
      aspect-ratio: auto;
      padding-top: var(--catalog-gap);
    }

    .catalog__conveyor {
      width: 100%;
    }

    .catalog__notes {
      position: static;
      align-items: stretch;
      margin-top: var(--catalog-grid-gap);
    }

    .catalog__note {
      width: auto;
      margin-inline-end: 0;
    }

    .catalog__note--printer {
      grid-template-columns: minmax(0, 1fr) 40%;
    }
  }
</style>

<script>
  import { waveOnView } from '@/scripts/catalog-wave';

  // карточки выезжают волной, когда сетка доезжает до экрана
  const grid = document.querySelector<HTMLElement>('[data-catalog-grid]');
  if (grid) waveOnView(grid);

  // фото принтера открывается крупно в <dialog>; закрыть – крестиком, Esc или тапом мимо фото
  const dialog = document.querySelector<HTMLDialogElement>('[data-zoom-dialog]');
  const open = document.querySelector<HTMLButtonElement>('[data-zoom-open]');

  if (dialog && open) {
    open.addEventListener('click', () => dialog.showModal());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
