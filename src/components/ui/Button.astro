---
import type { HTMLAttributes } from 'astro/types';

// без href рендерится <button type="button">
type Props = HTMLAttributes<'a'> & HTMLAttributes<'button'> & {
  href?: string;
  arrow?: boolean;
};

const { href, arrow = false, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag class:list={['button', className]} href={href} type={href ? undefined : 'button'} data-scroll-lift {...rest}>
  <slot />
  {arrow && (
    <svg class="button__arrow" viewBox="0 0 10 16" aria-hidden="true">
      <path d="M2 2l6 6-6 6" />
    </svg>
  )}
</Tag>

<style>
  .button {
    --button-padding-block: 20px;
    --button-padding-inline: 25px;
    --button-line-height: 1.2;
    --button-arrow-size: 0.8em;
    --button-arrow-gap: 12px;
    --button-arrow-stroke: 2.5px;

    display: inline-flex;
    width: 100%;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    /* обводка съедает часть паддинга, чтобы размер не менялся */
    padding: calc(var(--button-padding-block) - var(--stroke-lift)) calc(var(--button-padding-inline) - var(--stroke-lift));
    border: var(--stroke-lift) solid transparent;
    border-radius: var(--radius-pill);
    background: var(--color-button);
    color: var(--color-black);
    font-family: var(--font-main);
    font-size: var(--fs-button);
    font-weight: var(--fw-semibold);
    line-height: var(--button-line-height);
    text-align: center;
    text-decoration: none;
    transition: transform var(--transition-lift), box-shadow var(--transition-lift), border-color var(--transition-lift);
  }

  .button__arrow {
    width: var(--button-arrow-size);
    height: var(--button-arrow-size);
    margin-inline-start: var(--button-arrow-gap);
    fill: none;
    stroke: currentColor;
    stroke-width: var(--button-arrow-stroke);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* поднята: наведение, фокус или прокрутка (data-lifted ставит scroll-lift.ts) – одно состояние */
  .button:focus-visible,
  .button[data-lifted] {
    background: var(--color-accent);
    transform: translateY(var(--lift-hover));
    border-color: var(--color-black);
    box-shadow: var(--shadow-lift);
    outline: none;
  }

  /* на таче :hover залипает после тапа, поэтому ховер только для мыши */
  @media (hover: hover) {
    .button:hover {
      background: var(--color-accent);
      transform: translateY(var(--lift-hover));
      border-color: var(--color-black);
      box-shadow: var(--shadow-lift);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }

    .button:hover,
    .button:focus-visible,
    .button[data-lifted] {
      transform: none;
    }
  }
</style>
