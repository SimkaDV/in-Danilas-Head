---
import type { HTMLAttributes } from 'astro/types';

// без href рендерится <button type="button">
type Props = HTMLAttributes<'a'> & HTMLAttributes<'button'> & {
  href?: string;
  arrow?: boolean;
};

const { href, arrow = false, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag class:list={['button', className]} href={href} type={href ? undefined : 'button'} {...rest}>
  <slot />
  {arrow && (
    <svg class="button__arrow" viewBox="0 0 10 16" aria-hidden="true">
      <path d="M2 2l6 6-6 6" />
    </svg>
  )}
</Tag>

<style>
  .button {
    --button-padding-block: 20px;
    --button-padding-inline: 25px;
    --button-focus-width: 2px;
    --button-focus-offset: 3px;
    --button-line-height: 1.2;
    --button-arrow-size: 0.8em;
    --button-arrow-gap: 12px;
    --button-arrow-stroke: 2.5px;

    display: inline-flex;
    width: 100%;
    border: none;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    padding: var(--button-padding-block) var(--button-padding-inline);
    border-radius: var(--radius-pill);
    background: var(--color-button);
    color: var(--color-black);
    font-family: var(--font-main);
    font-size: var(--fs-button);
    font-weight: var(--fw-semibold);
    line-height: var(--button-line-height);
    text-align: center;
    text-decoration: none;
  }

  .button__arrow {
    width: var(--button-arrow-size);
    height: var(--button-arrow-size);
    margin-inline-start: var(--button-arrow-gap);
    fill: none;
    stroke: currentColor;
    stroke-width: var(--button-arrow-stroke);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .button:hover {
    background: var(--color-accent);
  }

  .button:focus-visible {
    outline: var(--button-focus-width) solid var(--color-black);
    outline-offset: var(--button-focus-offset);
  }
</style>
