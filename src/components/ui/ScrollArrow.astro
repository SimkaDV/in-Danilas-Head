---
interface Props {
  href: string;
}

const { href } = Astro.props;
---
<a class="scroll-arrow" href={href} aria-label="Листать дальше">
  <svg viewBox="0 0 82 47" aria-hidden="true">
    <path d="M2 2 41 44 80 2" />
  </svg>
</a>

<style>
  .scroll-arrow {
    --arrow-width: clamp(48px, 8vw, 82px);
    --arrow-stroke-width: 3px;
    --arrow-focus-width: 2px;
    --arrow-focus-offset: 3px;
    --arrow-pulse-duration: 2s;

    display: block;
    width: var(--arrow-width);
    color: var(--color-black);
    animation: scroll-arrow-pulse var(--arrow-pulse-duration) ease-in-out infinite;
  }

  .scroll-arrow svg {
    width: 100%;
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: var(--arrow-stroke-width);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* стрелка сама по кругу загорается и поднимается, как на ховере;
     у неё нет плашки, поэтому вместо обводки и тени-коробки — тень самой линии */
  @keyframes scroll-arrow-pulse {
    50% {
      color: var(--color-accent);
      transform: translateY(var(--lift-hover-sm));
      filter: drop-shadow(var(--shadow-lift-sm));
    }
  }

  /* на ховере и фокусе держится поднятой */
  .scroll-arrow:focus-visible {
    animation: none;
    color: var(--color-accent);
    transform: translateY(var(--lift-hover-sm));
    filter: drop-shadow(var(--shadow-lift-sm));
  }

  @media (hover: hover) {
    .scroll-arrow:hover {
      animation: none;
      color: var(--color-accent);
      transform: translateY(var(--lift-hover-sm));
      filter: drop-shadow(var(--shadow-lift-sm));
    }
  }

  .scroll-arrow:focus-visible {
    outline: var(--arrow-focus-width) solid var(--color-black);
    outline-offset: var(--arrow-focus-offset);
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-arrow {
      animation: none;
    }

    .scroll-arrow:hover,
    .scroll-arrow:focus-visible {
      transform: none;
    }
  }
</style>
